# KintsuTech Backend Environment Configuration Template
# Copy this file to .env and replace placeholder values before deployment.
# NEVER commit real credentials or secret values to version control.

# Deployment environment ('development' | 'production')
# In production, missing or insecure secrets will fail-closed and abort startup.
ENVIRONMENT=development

# Supabase Authentication
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-optional
SUPABASE_AUDIENCE=authenticated
SUPABASE_ISSUER=

# API-Key Authentication (Required in production, >= 16 characters)
# Protects repair activation, rollback, baseline modification, and MCP tool execution.
KINTSUTECH_API_KEY=replace_with_min_16_char_secure_api_key

# Enforce authentication in development (always enforced in production)
KINTSUTECH_REQUIRE_AUTH=false

# Webhook HMAC-SHA256 Signing Secret (Required in production, >= 16 characters)
KINTSUTECH_WEBHOOK_SECRET=replace_with_min_16_char_secure_webhook_secret

# CORS Allowed Origins (Comma-separated list; wildcards '*' are rejected in production)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Connection URL (SQLite default shown, or PostgreSQL/MySQL connection string)
# For SQLite, ensure the hosting container or host has persistent disk mounted.
KINTSUTECH_DATABASE_URL=sqlite:///backend/data/kintsutech.db

# Upstream Service Provider Target URL
WEATHER_PROVIDER_URL=http://127.0.0.1:8000/api/v1/mock/weather

# Request Body Size Limit in bytes (Default: 1048576 = 1 MB)
MAX_REQUEST_BODY_SIZE=1048576

# Rate Limiting Configuration
KINTSUTECH_RATE_LIMIT_ENABLED=true
RATE_LIMIT_MUTATION_PER_MINUTE=60
RATE_LIMIT_WEBHOOK_INGEST_PER_MINUTE=120

# Reverse Proxy Trust Settings ('true' | 'false')
# Only enable if your application is deployed behind a trusted reverse proxy (e.g., NGINX, Cloudflare)
# When false, X-Forwarded-For headers are untrusted and client socket IP is used directly.
KINTSUTECH_TRUST_PROXY=false
